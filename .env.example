# Copy this file to .env and edit as needed. Every value here has a default in config.py.

# Which chat model provider to use: ollama (default), anthropic, or fake (offline, for tests).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b

# Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Which embedding provider to use: ollama (default) or fake (offline, for tests).
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector store and retrieval.
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=rag_attack_lab
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
LLM_TEMPERATURE=0
